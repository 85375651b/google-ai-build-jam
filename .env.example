# Google Gemini API Configuration
# Get an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Unified Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Tavily Online Research API Configuration (Optional for supplementary web research)
# Get an API key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Local Storage & Reference Book Configuration
DATABASE_URL=sqlite:///./data/worldbuilding.db
PRIMARY_REFERENCE_BOOK_PATH="./The planet construction kit (Rosenfelder, Mark, author) (z-library.sk, 1lib.sk, z-lib.sk).pdf"
