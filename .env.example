# Local inference via Ollama. No model API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=gpt-oss:20b
LOCAL_CONTEXT_WINDOW=32768
LOCAL_MAX_OUTPUT_TOKENS=4096
# Ollama inactivity timeout between network chunks, including hidden reasoning
LOCAL_REQUEST_TIMEOUT=600
# Overall lifecycle deadline, including classification and post-processing
GENERATION_DEADLINE_SECONDS=3600
GENERATION_HEARTBEAT_SECONDS=5
GENERATION_CLIENT_IDLE_SECONDS=45
# Input-context estimates include instructions, sources and conversation history.
# Essential canon/constraints are preserved; unsafe overflow is reported explicitly.
CONSULTATION_CONTEXT_TOKENS=12000
EXTRACTION_CONTEXT_TOKENS=10000
CONTEXT_RECENT_MESSAGES=6
CONTEXT_HISTORY_EXCERPTS=8

# Optional web research. Leave empty for offline operation.
TAVILY_API_KEY=

DATABASE_URL=sqlite:///./data/worldbuilding.db
PRIMARY_REFERENCE_BOOK_PATH="./The planet construction kit (Rosenfelder, Mark, author) (z-library.sk, 1lib.sk, z-lib.sk).pdf"

# Optional local task routes. Empty values inherit LOCAL_MODEL.
# Enable only after task-specific quality and residency benchmarks.
LOCAL_CLASSIFICATION_MODEL=
LOCAL_EXTRACTION_MODEL=
LOCAL_SUMMARIZATION_MODEL=
LOCAL_KEEP_ALIVE=10m
